# ───────────────────────── Network ─────────────────────────
# 46630 = Robinhood Chain Testnet (default) · 31337 = local anvil · 84532 = Base Sepolia (fallback)
NEXT_PUBLIC_CHAIN_ID=46630
# Optional RPC overrides (public endpoints are used when empty)
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
# Server-side RPC (e.g. an Alchemy key URL); falls back to the chain's public RPC
RPC_URL=

# ───────────────────────── Wallets ─────────────────────────
# Free at https://dashboard.reown.com — enables WalletConnect / mobile wallets.
# Without it, only injected (browser extension) wallets and Coinbase Wallet are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Local-only burner wallet (anvil account #1). Only honoured when NEXT_PUBLIC_CHAIN_ID=31337.
NEXT_PUBLIC_ENABLE_DEV_WALLET=false

# ───────────────────────── Contracts ───────────────────────
# Normally read from src/lib/generated/deployments.ts (npm run contracts:sync).
# Set these to point a deployment at new addresses without a code change.
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_FAUCET_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_TERRITORY_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_OPS_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=

# ───────────────────────── Site ────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────────────────────── Backend (server only) ───────────
# Supabase project (Settings → API). Without these the SI backend uses an in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for the daily cron (Vercel sends `Authorization: Bearer $CRON_SECRET`)
CRON_SECRET=
# Changes the deterministic SI event schedule
SI_SEED=planet-wars-si/overmind/v1
# Optional OpenAI-compatible LLM for SI broadcasts
SI_LLM_API_KEY=
SI_LLM_BASE_URL=https://api.openai.com/v1
SI_LLM_MODEL=gpt-4o-mini

# ───────────────────────── Contract deployment (never commit) ─
# Used only by `forge script` (contracts/). Export in your shell or a secrets manager.
# DEPLOYER_PRIVATE_KEY=
# RESISTANCE_FUND=
# METADATA_BASE_URI=https://<your-domain>/api/metadata/
