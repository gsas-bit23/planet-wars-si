# ───────────────────────── Network ─────────────────────────
# 46630 = Robinhood Chain Testnet (default) · 31337 = local anvil · 84532 = Base Sepolia (fallback)
NEXT_PUBLIC_CHAIN_ID=46630
# Optional RPC overrides (public endpoints are used when empty)
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
# Robinhood Chain mainnet (4663)
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
# Server-side RPC (e.g. an Alchemy key URL); falls back to the chain's public RPC
RPC_URL=

# ───────────────────────── Wallets ─────────────────────────
# Free at https://dashboard.reown.com — enables WalletConnect / mobile wallets.
# Without it, only injected (browser extension) wallets and Coinbase Wallet are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Local-only burner wallet (anvil account #1). Only honoured when NEXT_PUBLIC_CHAIN_ID=31337.
NEXT_PUBLIC_ENABLE_DEV_WALLET=false

# ───────────────────────── Contracts ───────────────────────
# Normally read from src/lib/generated/deployments.json (npm run contracts:sync); the build
# (scripts/select-network.mjs) embeds only the NEXT_PUBLIC_CHAIN_ID entry (default 4663).
# Set these to point a deployment at new addresses without a code change.
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_FAUCET_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_REWARD_POOL_ADDRESS=
NEXT_PUBLIC_DAILY_DRAW_ADDRESS=
NEXT_PUBLIC_TERRITORY_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_OPS_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=
# Protocol wallets excluded from rewards (normally from the deployment file)
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_DEPLOYER_ADDRESS=
# Chains without a faucet (mainnet) hide the faucet page/link. Optional "Get PWSI" link instead,
# e.g. the token's pons launchpad page.
NEXT_PUBLIC_TOKEN_BUY_URL=

# ───────────────────────── Site ────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────────────────────── Backend (server only) ───────────
# Supabase project (Settings → API). Without these the SI backend uses an in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for the daily cron (Vercel sends `Authorization: Bearer $CRON_SECRET`)
CRON_SECRET=
# Changes the deterministic SI event schedule
SI_SEED=planet-wars-si/overmind/v1
# Optional OpenAI-compatible LLM for SI broadcasts
SI_LLM_API_KEY=
SI_LLM_BASE_URL=https://api.openai.com/v1
SI_LLM_MODEL=gpt-4o-mini

# ───────────────────────── Rewards (server only) ───────────
# Operator key: commits/reveals the daily lottery and publishes Merkle roots (PUBLISHER/OPERATOR role).
# Gas-only wallet. Never the deployer/admin key. Mark as sensitive in Vercel.
OPERATOR_PRIVATE_KEY=
# HMAC key for lottery seeds (keep stable; rotating it breaks reveals of committed rounds)
LOTTERY_SECRET=
# Lottery eligibility window in UTC days
LOTTERY_ACTIVITY_DAYS=7
# Extra wallets excluded from leaderboard / lottery / airdrop (comma-separated)
REWARDS_EXCLUDE=

# ───────────────────────── Contract deployment (never commit) ─
# Used only by `forge script` (contracts/). Export in your shell or a secrets manager.
# DEPLOYER_PRIVATE_KEY=
# OPERATOR_ADDRESS=0x...                         # rewards operator (defaults to the deployer)
# METADATA_BASE_URI=https://<your-domain>/api/metadata/
# CONTRACT_URI=https://<your-domain>/api/metadata/contract
# AIRDROP_ALLOCATION=10000000000000000000000000  # testnet only (Deploy.s.sol), wei
# Mainnet (DeployMainnet.s.sol): no token, no faucet. The token is launched on pons.
# TOKEN_ADDRESS=0x...                            # the external ERC-20
# ADMIN_ADDRESS=0xSafe...                        # final admin (Safe multisig); deployer renounces
# BURN_MODE=dead                                 # "dead" (transfer to 0x…dEaD) or "burn" (token.burn)
# DEPLOY_OUT=deployments/dryrun-4663.json        # optional output path for dry runs
